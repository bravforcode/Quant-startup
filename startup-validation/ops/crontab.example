# Supabase keep-alive (playbook C.4, option 1). Install with: crontab -e
# Runs every 3 days at 03:00 server time (day-of-month */3 gives days 1,4,7,...,31,
# so gaps are 1-3 days and restart each month).
# Needs env vars: cron does not load your shell profile, so set them here
# (replace the placeholders; do not commit real values):
#   SUPABASE_URL, SUPABASE_ANON_KEY (required)
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (optional, failure alert)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

0 3 */3 * * /path/to/Quant-startup/startup-validation/ops/keepalive.sh
